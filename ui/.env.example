# If omitted, the UI uses the Vite proxy at /api.
# For direct browser-to-MS1 calls via CORS, uncomment this line:
# VITE_API_BASE_URL=http://localhost:8080/api

# If omitted, the UI uses the Vite proxy at /rag-api for MS2 chat.
# For direct browser-to-MS2 calls via CORS, uncomment this line:
# VITE_MS2_API_BASE_URL=http://localhost:8000

# Admin key for MS2 reconcile/rebuild. The Vite dev proxy adds it as X-API-Key,
# so it is never exposed to the browser. Defaults to dev-admin-key.
# MS2_ADMIN_API_KEY=dev-admin-key
