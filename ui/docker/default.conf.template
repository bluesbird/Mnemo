# Caddy's fixed address is the only trusted source of the original client IP.
set_real_ip_from 172.30.0.2;
real_ip_header X-Real-IP;

map "${UI_RATE_LIMITS}" $per_ip_limit_key {
    default $binary_remote_addr;
    off "";
}
map "${UI_RATE_LIMITS}" $global_limit_key {
    default $server_name;
    off "";
}

limit_req_zone $per_ip_limit_key zone=chat_per_ip:10m rate=30r/m;
limit_req_zone $per_ip_limit_key zone=summarize_per_ip:10m rate=10r/m;
limit_req_zone $global_limit_key zone=reconcile_global:1m rate=1r/m;
limit_req_zone $global_limit_key zone=rebuild_global:1m rate=1r/m;
limit_conn_zone $global_limit_key zone=ollama_work:1m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Preserve nginx's request variables; envsubst replaces only the allowlist.
    proxy_http_version 1.1;
    proxy_set_header X-API-Key "";
    proxy_set_header Connection "";
    proxy_read_timeout 300s;
    client_max_body_size 256k;
    limit_req_status 429;
    limit_conn_status 429;

    location = /api {
        proxy_pass ${UI_KNOWLEDGE_UPSTREAM};
    }
    location ~ ^/api/v1/notes/[0-9]+/summarize$ {
        limit_req zone=summarize_per_ip burst=5 nodelay;
        limit_conn ollama_work 2;
        proxy_pass ${UI_KNOWLEDGE_UPSTREAM};
    }
    location /api/ {
        proxy_pass ${UI_KNOWLEDGE_UPSTREAM};
    }
    location = /rag-api {
        proxy_pass ${UI_RAG_UPSTREAM}/;
        proxy_set_header X-API-Key "";
        proxy_set_header Connection "";
    }
    location = /rag-api/api/v1/chat/query {
        limit_req zone=chat_per_ip burst=20 nodelay;
        limit_conn ollama_work 2;
        proxy_pass ${UI_RAG_UPSTREAM}/api/v1/chat/query;
        proxy_set_header X-API-Key "";
        proxy_set_header Connection "";
    }
    location = /rag-api/api/v1/index/reconcile {
        limit_req zone=reconcile_global;
        limit_conn ollama_work 2;
        proxy_pass ${UI_RAG_UPSTREAM}/api/v1/index/reconcile;
        proxy_set_header X-API-Key "";
        proxy_set_header Connection "";
    }
    location = /rag-api/api/v1/index/rebuild {
        limit_req zone=rebuild_global;
        limit_conn ollama_work 2;
        proxy_pass ${UI_RAG_UPSTREAM}/api/v1/index/rebuild;
        proxy_set_header X-API-Key "";
        proxy_set_header Connection "";
    }
    location /rag-api/ {
        proxy_pass ${UI_RAG_UPSTREAM}/;
        proxy_set_header X-API-Key "";
        proxy_set_header Connection "";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
