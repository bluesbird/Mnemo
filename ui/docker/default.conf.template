server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Preserve nginx's request variables; envsubst replaces only the allowlist.
    proxy_http_version 1.1;
    proxy_set_header X-API-Key "";
    proxy_set_header Connection "";
    proxy_read_timeout 300s;
    client_max_body_size 10m;

    location = /api {
        proxy_pass ${UI_MS1_UPSTREAM};
    }
    location /api/ {
        proxy_pass ${UI_MS1_UPSTREAM};
    }
    location = /rag-api {
        proxy_pass ${UI_MS2_UPSTREAM}/;
        proxy_set_header X-API-Key "";
        proxy_set_header Connection "";
    }
    location /rag-api/ {
        proxy_pass ${UI_MS2_UPSTREAM}/;
        proxy_set_header X-API-Key "";
        proxy_set_header Connection "";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
